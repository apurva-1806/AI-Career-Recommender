# Copy to .env and adjust. Every value is optional.

# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql://career:career@localhost:5432/career
DATABASE_URL=sqlite:///./career.db

# auto  = sentence-transformers if installed and loadable, otherwise TF-IDF
# sbert = sentence-transformers only (startup fails if it cannot load)
# tfidf = scikit-learn TF-IDF only
EMBEDDING_BACKEND=auto
SBERT_MODEL=all-MiniLM-L6-v2

TOP_K=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts
SESSION_DAYS=30
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0

# Supervised ML classifier (trained automatically on first start)
USE_CLASSIFIER=1
SAMPLES_PER_CAREER=80
